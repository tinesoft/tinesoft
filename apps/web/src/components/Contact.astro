---
import { SOCIALS } from '../lib/site'
---

<section id="contact" class="contact container">
  <div class="box panel">
    <div class="intro">
      <div class="module">
        &gt; module 05 · handshake<span class="caret"></span>
      </div>
      <h2>Let's build better tools together.</h2>
      <p>
        Good first issues are labelled in every repo. Open a PR, propose an idea, or just say hi.
      </p>
      <ul class="facts">
        <li>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path>
            <circle cx="12" cy="9" r="2.5"></circle>
          </svg>
          Based in Luxembourg
        </li>
        <li>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="7" width="18" height="13" rx="2"></rect>
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <a href="https://www.sfeir.com" class="employer" rel="noopener">
            @SFEIR
          </a>
        </li>
        <li>
          <span class="live"></span>Open to OSS collaborations
        </li>
      </ul>
    </div>
    <ul class="socials">
      {SOCIALS.map(s => (
        <li>
          <a href={s.href} class="social btn" rel="me">
            <span class="name">{s.name}</span>
            <span class="handle">{s.handle}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-top: 104px;
  }

  .box {
    border-radius: 24px;
    padding: clamp(28px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .intro {
    max-width: 560px;
  }

  .module {
    font: 500 13px var(--mono);
    color: var(--acc);
  }

  h2 {
    margin: 10px 0 0;
    font: 700 40px / 1.1 var(--display);
    letter-spacing: -0.03em;
  }

  p {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .facts {
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-size: 14px;
  }

  .employer {
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .employer:hover {
    color: var(--acc);
    text-decoration-color: currentColor;
  }

  .socials {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: min(100%, 360px);
  }

  .social {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .name {
    font-weight: 600;
    font-size: 15px;
  }

  .handle {
    font: 400 12px var(--mono);
    color: var(--muted);
  }
</style>
