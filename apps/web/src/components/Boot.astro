---
/* Shown once per browser session; skipped under reduced motion. */
---

<div class="boot" id="boot" hidden aria-hidden="true">
  <div class="inner">
    <div class="line">
      › init tinesoft.agent v{new Date().getFullYear()}.{new Date().getMonth() + 1}
    </div>
    <div class="line">› loading modules: tools · ai-lab · telemetry</div>
    <div class="bar">
      <div class="fill" id="boot-fill"></div>
    </div>
    <div class="status">
      <span>BOOTING</span>
      <span id="boot-pct">0%</span>
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion } from '../scripts/motion'

  const boot = document.getElementById('boot')!
  const seen = (() => {
    try {
      return sessionStorage.getItem('tinesoft:booted') === '1'
    } catch {
      return true
    }
  })()

  if (!seen && !prefersReducedMotion()) {
    try {
      sessionStorage.setItem('tinesoft:booted', '1')
    } catch {
      // Storage is blocked: the boot screen shows again next time.
    }
    boot.hidden = false
    const fill = document.getElementById('boot-fill')!
    const pct = document.getElementById('boot-pct')!
    const start = performance.now()
    const step = (now: number) => {
      const p = Math.min(100, Math.round(((now - start) / 1600) * 100))
      fill.style.width = `${p}%`
      pct.textContent = `${p}%`
      if (p < 100) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
    boot.addEventListener('animationend', () => boot.remove())
  }
</script>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    animation: bootout 2.4s ease forwards;
  }

  .boot[hidden] {
    display: none;
  }

  .inner {
    width: min(420px, 84vw);
  }

  .line {
    font-size: 13px;
    color: var(--muted);
  }

  .line + .line {
    margin-top: 6px;
  }

  .bar {
    margin-top: 18px;
    height: 6px;
    border-radius: 99px;
    background: var(--surface2);
    overflow: hidden;
  }

  .fill {
    height: 100%;
    width: 0;
    background: var(--acc);
  }

  .status {
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--acc);
  }

  @keyframes bootout {
    0%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
