{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/tests/**/*", "!{projectRoot}/**/*.test.ts"],
    "toolchain": ["{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/.prettierrc.json"]
  },
  "targetDefaults": {
    "lint": { "cache": true, "inputs": ["default", "toolchain"] },
    "typecheck": { "cache": true, "inputs": ["default"] },
    "test": { "cache": true, "inputs": ["default"] },
    "build": { "cache": true, "inputs": ["production"], "outputs": ["{projectRoot}/dist"] }
  },
  "analytics": false
}
